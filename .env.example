# Template d'environnement — copie en `.env` pour le dev local.
# La validation Zod (src/shared/config/env.schema.ts) bloque le boot si une
# variable obligatoire manque ou si une valeur est invalide.
#
# En prod (Railway), les valeurs sont injectées par la plateforme ; aucun
# .env n'est lu (`ignoreEnvFile: true`). Railway fournit DATABASE_URL et
# REDIS_URL : les composants DB_*/REDIS_* ne servent qu'en local.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development              # development | test | production
APP_ENV=local                     # nom libre de l'environnement de déploiement
PORT=8080
HOST=0.0.0.0
TRUST_PROXY_HOPS=0                # 1 derrière le proxy Railway

# --- PostgreSQL (docker-compose) ---------------------------------------------
# Forme 1 (Railway) : DATABASE_URL=postgres://user:pass@host:5432/db
# Forme 2 (local)   : composants séparés
DB_HOST=localhost
DB_PORT=5433                      # port hôte du compose (5432 = Postgres natif cinaf)
DB_NAME=voxlivre
DB_USER=voxlivre
DB_PASSWORD=voxlivre_dev_password
DB_POOL_MAX=10
DB_SSL=false

# --- Redis (docker-compose) --------------------------------------------------
# Forme 1 (Railway) : REDIS_URL=redis://default:pass@host:6379
# Forme 2 (local). Optionnel en dev : absent → rate-limit in-memory.
REDIS_HOST=localhost
REDIS_PORT=6380                   # port hôte du compose (6379 = Redis natif)
REDIS_TLS=false

# --- Surface HTTP ------------------------------------------------------------
# SWAGGER_ENABLED=true            # défaut : activé hors production
CORS_ALLOWED_ORIGINS=             # vide → fallback http://localhost:3000 hors prod
RATE_LIMIT_TTL_MS=1000
RATE_LIMIT_MAX=10

# --- Observabilité -----------------------------------------------------------
# LOG_LEVEL=debug                 # défaut : debug hors prod, info en prod
SLOW_QUERY_WARN_MS=100
SLOW_QUERY_ERROR_MS=500

# --- Sécurité applicative ----------------------------------------------------
# Secrets ≥ 32 caractères. Générer : `openssl rand -base64 48`
# CURSOR_HMAC_SECRET=             # requis en production
BETTER_AUTH_SECRET=change-me-in-real-env-this-is-only-for-local-dev
BETTER_AUTH_URL=http://localhost:8080

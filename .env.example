# Template d'environnement — copie en `.env` pour le dev local.
# La validation Zod (src/shared/config/env.schema.ts) bloque le boot si une
# variable obligatoire manque ou si une valeur est invalide.
#
# En prod (Railway), les valeurs sont injectées par la plateforme ; aucun
# .env n'est lu (`ignoreEnvFile: true`). Railway fournit DATABASE_URL et
# REDIS_URL : les composants DB_*/REDIS_* ne servent qu'en local.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development              # development | test | production
APP_ENV=local                     # nom libre de l'environnement de déploiement
PORT=8080
HOST=0.0.0.0
TRUST_PROXY_HOPS=0                # 1 derrière le proxy Railway

# --- PostgreSQL (docker-compose) ---------------------------------------------
# Forme 1 (Railway) : DATABASE_URL=postgres://user:pass@host:5432/db
# Forme 2 (local)   : composants séparés
DB_HOST=localhost
DB_PORT=5433                      # port hôte du compose (5432 = Postgres natif cinaf)
DB_NAME=voxlivre
DB_USER=voxlivre
DB_PASSWORD=voxlivre_dev_password
DB_POOL_MAX=10
DB_SSL=false

# --- Redis (docker-compose) --------------------------------------------------
# Forme 1 (Railway) : REDIS_URL=redis://default:pass@host:6379
# Forme 2 (local). Optionnel en dev : absent → rate-limit in-memory.
REDIS_HOST=localhost
REDIS_PORT=6380                   # port hôte du compose (6379 = Redis natif)
REDIS_TLS=false

# --- Surface HTTP ------------------------------------------------------------
# SWAGGER_ENABLED=true            # défaut : activé hors production
CORS_ALLOWED_ORIGINS=             # vide → fallback http://localhost:3000 hors prod
RATE_LIMIT_TTL_MS=1000
RATE_LIMIT_MAX=10

# --- Observabilité -----------------------------------------------------------
# LOG_LEVEL=debug                 # défaut : debug hors prod, info en prod
SLOW_QUERY_WARN_MS=100
SLOW_QUERY_ERROR_MS=500

# --- Sécurité applicative ----------------------------------------------------
# Secrets ≥ 32 caractères. Générer : `openssl rand -base64 48`
# CURSOR_HMAC_SECRET=             # requis en production
BETTER_AUTH_SECRET=change-me-in-real-env-this-is-only-for-local-dev
BETTER_AUTH_URL=http://localhost:8080
# BETTER_AUTH_TRUSTED_ORIGINS=     # origines supplémentaires (CSRF), séparées par virgule

# --- Identity / OTP ----------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRES_IN_SECONDS=300
OTP_ALLOWED_ATTEMPTS=3
OTP_DELIVERY_MODE=log             # log (dev : code dans les logs) | notification (prod, à venir)
# OTP_LOG_DELIVERY_UNSAFE_ALLOW=false  # autorise `log` en production (déconseillé)
SESSION_EXPIRES_IN_SECONDS=2592000   # 30 jours
SESSION_UPDATE_AGE_SECONDS=86400     # 1 jour
AUTH_RATE_LIMIT_STORAGE=database     # database (partagé) | memory (e2e uniquement)

# --- Stockage objet S3-compatible (ADR-0007) ---------------------------------
# Prod : Cloudflare R2 (endpoint https://<account-id>.r2.cloudflarestorage.com,
# token scoped au bucket). Local : RustFS du docker-compose.
# Absent en dev → les routes /v1/documents répondent 503.
S3_ENDPOINT=http://localhost:9002
S3_REGION=auto
S3_BUCKET=voxlivre-dev
S3_ACCESS_KEY_ID=voxlivre_dev_access
S3_SECRET_ACCESS_KEY=voxlivre_dev_secret_key
S3_FORCE_PATH_STYLE=true             # requis par RustFS/MinIO ; R2 : false

# --- Documents ---------------------------------------------------------------
DOCUMENT_MAX_SIZE_BYTES=52428800     # 50 Mo

# --- Tâches asynchrones (ADR-0009) -------------------------------------------
# API et workers BullMQ dans le même processus. false = aucun worker (e2e).
JOB_WORKERS_ENABLED=true

# --- Synthèse vocale : Amazon Polly (ADR-0013) -------------------------------
# fake = silence MP3 gratuit (dev, CI) ; polly = vraie voix, facturée.
# Aucune clé AWS ici : le SDK lit le profil (AWS_PROFILE=voxlivre en local)
# ou le rôle de l'instance (production).
TTS_PROVIDER=fake
# AWS_REGION=eu-west-3               # requis avec TTS_PROVIDER=polly
# AWS_PROFILE=voxlivre               # local uniquement, lu par le SDK

# --- Quota en caractères (ADR-0010) ------------------------------------------
FREE_TIER_CHARS_PER_MONTH=100000     # palier gratuit par mois civil UTC
MAX_CHARS_PER_CONVERSION=1000000     # plafond d'une conversion (RNF-25)

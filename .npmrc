# Refuser l'install si la version de Node ne respecte pas package.json#engines
engine-strict=true

# Auto-installer les peerDependencies (les projets TS/Nest en ont beaucoup)
auto-install-peers=true

# Tolérer les peers mismatch (warning au lieu de fail) — courant dans
# l'écosystème typescript-eslint / nest / drizzle
strict-peer-dependencies=false

# CI-friendly : refuser tout drift entre package.json et lockfile en CI
prefer-frozen-lockfile=true

# Garder les ranges ^X.Y.Z par défaut pour les minor bumps automatiques
save-exact=false

# Activer pre/post-scripts (nécessaire pour husky `prepare`)
enable-pre-post-scripts=true
